# Everything the build writes
# (in any directory: a run started from the wrong directory makes one there)
out/
# build/build.mk's Wine prefix, generated rules and header dependencies
/.wine/
/.build/
# the project files put every output in a built/ directory
src/**/[Bb]uilt/
# generated by flex/bison at build time (src/Game/ObjectDLL/)
src/Game/ObjectDLL/AnimationLex.o
src/Game/ObjectDLL/AnimationParse.o
src/Game/ObjectDLL/AnimationLexSymbols.h

__pycache__/
*.log
!src/**/*.log
# agents' worktrees (tools/agentwt.sh)
/.worktrees/
